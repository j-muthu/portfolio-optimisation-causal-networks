# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# OS
.DS_Store

# Claude local settings
.claude/settings.local.json

# Reference PDFs — papers kept locally, not version-controlled
*.pdf

# Data cache (downloaded prices / Wikipedia tables — regenerable)
cache/

# Rodriguez-Dominguez HSP reference dataset — published-paper supplements
# kept locally for tests/test_hsp_reference.py but not redistributed.
HSP/

# Experiment artefacts: pickled results are large; CSVs/PNGs/logs are tracked
results/**/*.pkl
# Per-run feedback state — regenerable, and the exploratory runs are noise.
results/**/utility.parquet

# Local secrets (API keys / WRDS credentials) — never commit
.env
*.env.local

old_notes/

# Superseded report folders + old notes, kept locally only.
archive/

varlingam_docs/

latex_template/*

# final_report: track LaTeX source + figures + generated macros, but not the
# LaTeX build intermediates.
final_report/main.aux
final_report/main.bbl
final_report/main.bcf
final_report/main.blg
final_report/main.fdb_latexmk
final_report/main.fls
final_report/main.log
final_report/main.out
final_report/main.run.xml
final_report/main.toc
final_report/main.lof
